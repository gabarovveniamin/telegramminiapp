[Unit]
Description=Telegram Bot Admin Backend
After=network.target

[Service]
User=ubuntu
Group=www-data
WorkingDirectory=/home/ubuntu/telegramminiapp/backend
Environment="PATH=/home/ubuntu/telegramminiapp/backend/venv/bin"
ExecStart=/home/ubuntu/telegramminiapp/backend/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000

[Install]
WantedBy=multi-user.target
